# ── Auth (shared-password gate) ───────────────────────────
# Leave empty in local dev to skip auth. REQUIRED in production
# (the middleware will refuse to serve any page if unset).
DASHBOARD_PASSWORD=

# ── Airtable ──────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Mailchimp ─────────────────────────────────────────────
# Full key includes the dc suffix, e.g. abc123-us8
MAILCHIMP_API_KEY=
# Parsed from the key suffix above; e.g. us8. Leave blank to auto-derive.
MAILCHIMP_SERVER_PREFIX=
# Optional: pin to a specific audience (list). Otherwise the first one wins.
MAILCHIMP_LIST_ID=

# ── Google Analytics 4 (Data API via service account) ─────
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Paste the private key as one line with \n for newlines, OR wrap in quotes
# and keep literal newlines. Code handles both.
GA4_PRIVATE_KEY=

# Umami Cloud API (LMS analytics)
UMAMI_API_KEY=
UMAMI_WEBSITE_ID=859b32ca-fe0b-4438-be41-4864cae1c369
