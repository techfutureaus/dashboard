# ── Firebase (client auth) ────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Restrict sign-in to a specific Google Workspace domain.
# Leave empty to allow any Google account.
NEXT_PUBLIC_ALLOWED_DOMAIN=

# ── Airtable ──────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ── Mailchimp ─────────────────────────────────────────────
# Full key includes the dc suffix, e.g. abc123-us8
MAILCHIMP_API_KEY=
# Parsed from the key suffix above; e.g. us8. Leave blank to auto-derive.
MAILCHIMP_SERVER_PREFIX=
# Optional: pin to a specific audience (list). Otherwise the first one wins.
MAILCHIMP_LIST_ID=

# ── Google Analytics 4 (Data API via service account) ─────
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# Paste the private key as one line with \n for newlines, OR wrap in quotes
# and keep literal newlines. Code handles both.
GA4_PRIVATE_KEY=
